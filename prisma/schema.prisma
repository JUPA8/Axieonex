// AXIEONEX backend data model.
//
// Phase 1 (foundation): Admin, ContactSubmission, BookingRequest.
// Phase 2 (this pass): Article (DB-backed Insights content), plus
// BookingRequest.calendarBookingUid and the *SyncedAt columns going live.
// No consent-platform/analytics wiring yet (Phase 3).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL is no longer read from this block. The CLI
// (migrate/generate) reads it from prisma.config.ts; the running app passes
// it to a @prisma/adapter-pg driver adapter in src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

/// A user who can sign in to /admin. Single flat role for this phase: every
/// admin has equal access, there is no permission-tier system.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@map("admins")
}

/// One submission of the /contact form.
model ContactSubmission {
  id        String   @id @default(cuid())
  purpose   String
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())

  /// IP address at submission time, used only for rate-limiting/abuse review.
  ipAddress String?

  /// Set once a Resend notification email is actually sent. Null means no
  /// provider was configured (EMAIL_PROVIDER_API_KEY unset) or the send
  /// attempt failed, the submission itself is never lost either way.
  emailSentAt DateTime?

  /// Phase 2 seam: set once this record has been pushed to the CRM. Null
  /// until CRM_API_KEY/CRM_WORKSPACE_ID are configured and wired up.
  crmSyncedAt DateTime?

  @@map("contact_submissions")
}

enum BookingStatus {
  /// Submitted and persisted, but not yet checked against a real calendar.
  PENDING
  /// Phase 2: confirmed against a real calendar provider.
  CONFIRMED
  /// Phase 2: the requested slot could not be honored.
  CANCELLED
}

/// One submission of the /book-strategy-call wizard.
model BookingRequest {
  id       String @id @default(cuid())
  name     String
  email    String
  phone    String
  role     String
  company  String
  website  String
  country  String
  size     String
  approach String
  outcome  String
  market   String
  budget   String

  /// The slot the visitor picked. When no calendar provider is configured,
  /// this is plain data from the mocked 4-weekday generator
  /// (src/lib/availability.ts) and `status` stays PENDING. When one is
  /// configured, this is the real slot start time and `calendarBookingUid`
  /// / `status` reflect the actual calendar API response.
  slotId    String
  slotLabel String

  /// Set once a real calendar provider confirms the booking. Null for
  /// mocked-availability requests and for any request made before a
  /// provider was configured.
  calendarBookingUid String?

  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())

  ipAddress String?

  emailSentAt DateTime?
  crmSyncedAt DateTime?

  @@map("booking_requests")
}

/// One Insights article. Replaces the previous titles-only placeholder
/// content (src/content/articles.ts) as of Phase 2, the Insights hub and
/// article routes now read published rows from here.
model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  /// Hex color used for the article's accent border on cards and the
  /// article page itself, matching the approved design's per-category
  /// color coding.
  color     String
  intro     String
  h2a       String
  bodyA     String
  h2b       String
  bodyB     String
  closing   String

  /// Drafts (published: false) are visible in /admin but never on the
  /// public site.
  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}
