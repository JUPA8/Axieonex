// AXIEONEX backend data model.
//
// Admin, submission, booking, article, and consent persistence. The migration
// history is the source of truth for when each capability was introduced.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL is no longer read from this block. The CLI
// (migrate/generate) reads it from prisma.config.ts; the running app passes
// it to a @prisma/adapter-pg driver adapter in src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

/// A user who can sign in to /admin. Single flat role for this phase: every
/// admin has equal access, there is no permission-tier system.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@map("admins")
}

/// One submission of the /contact form.
model ContactSubmission {
  id        String   @id @default(cuid())
  purpose   String
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// IP address at submission time, used only for rate-limiting/abuse review.
  ipAddress String?

  /// Set once a Resend notification email is actually sent. Use emailState to
  /// distinguish disabled, failed, not-attempted, and legacy outcomes when
  /// this timestamp is null.
  emailSentAt         DateTime?
  emailState          ProviderOperationState @default(NOT_ATTEMPTED)
  emailStateUpdatedAt DateTime?

  /// Set once this record has been pushed to the CRM. Use crmState to
  /// distinguish all non-success outcomes when this timestamp is null.
  crmSyncedAt       DateTime?
  crmState          ProviderOperationState @default(NOT_ATTEMPTED)
  crmStateUpdatedAt DateTime?

  @@map("contact_submissions")
}

enum BookingStatus {
  /// Submitted and persisted, but not yet checked against a real calendar.
  PENDING
  /// Phase 2: confirmed against a real calendar provider.
  CONFIRMED
  /// Phase 2: the requested slot could not be honored.
  CANCELLED
}

/// Durable, non-secret outcome of an optional provider operation. Historical
/// rows without enough evidence are LEGACY_UNKNOWN rather than inferred as a
/// failure. Provider credentials, responses, and error bodies are never stored.
enum ProviderOperationState {
  NOT_ATTEMPTED
  DISABLED
  SUCCEEDED
  FAILED
  LEGACY_UNKNOWN
}

/// One submission of the /book-strategy-call wizard.
model BookingRequest {
  id       String @id @default(cuid())
  name     String
  email    String
  phone    String
  role     String
  company  String
  website  String
  country  String
  size     String
  approach String
  outcome  String
  market   String
  budget   String

  /// The slot the visitor picked. When no calendar provider is configured,
  /// this is plain data from the mocked 4-weekday generator
  /// (src/lib/availability.ts) and `status` stays PENDING. When one is
  /// configured, this is the real slot start time and `calendarBookingUid`
  /// / `status` reflect the actual calendar API response.
  slotId    String
  slotLabel String

  /// Set only by the verified Calendly webhook after Calendly confirms the
  /// booking. Client-supplied embed events are never trusted as confirmation.
  calendarBookingUid String?

  /// Opaque server-generated value passed through Calendly's utm_content and
  /// used to correlate a signed webhook to this pending request.
  calendarCorrelationId String? @unique

  /// Calendly invitee URI. This is the provider delivery id and its unique
  /// constraint makes duplicate and concurrent webhook delivery idempotent.
  calendarInviteeUid String? @unique

  confirmedAt DateTime?

  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  ipAddress String?

  emailSentAt         DateTime?
  emailState          ProviderOperationState @default(NOT_ATTEMPTED)
  emailStateUpdatedAt DateTime?
  crmSyncedAt         DateTime?
  crmState            ProviderOperationState @default(NOT_ATTEMPTED)
  crmStateUpdatedAt   DateTime?

  @@map("booking_requests")
}

/// One Insights article. Replaces the previous titles-only placeholder
/// content (src/content/articles.ts) as of Phase 2, the Insights hub and
/// article routes now read published rows from here.
model Article {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  category String
  /// Hex color used for the article's accent border on cards and the
  /// article page itself, matching the approved design's per-category
  /// color coding.
  color    String
  intro    String
  h2a      String
  bodyA    String
  h2b      String
  bodyB    String
  closing  String

  /// Drafts (published: false) are visible in /admin but never on the
  /// public site.
  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

/// Durable, auditable record of a visitor's cookie-consent choice (Backend
/// Phase 3), replacing the previous localStorage-only implementation.
/// Correlated to a browser via an HttpOnly `axieonex_visitor_id` cookie
/// (src/app/api/consent/route.ts), not a third-party tracking identifier:
/// it exists only to let this one visitor's own choice be looked up and
/// updated, and to prove consent was actually given if ever audited.
/// localStorage is still used client-side, but only as a fast cache of
/// this row, not the source of truth.
model ConsentRecord {
  id        String @id @default(cuid())
  visitorId String @unique

  version     Int
  necessary   Boolean @default(true)
  functional  Boolean @default(false)
  analytics   Boolean @default(false)
  preferences Boolean @default(false)
  marketing   Boolean @default(false)

  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consent_records")
}
