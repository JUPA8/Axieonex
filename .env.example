# AXIEONEX production environment variables.
# No values are provided here. Copy to .env.local and fill in real values only
# once a provider has been selected for each integration — never commit real
# secrets. Every integration below fails gracefully (logs, does not crash,
# and reports an honest "not configured" state to the user) when unset. See
# axieonex-integrations.json in the design handoff for full detail on each.

# Public site URL, used for canonical/OG URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.axieonex.com

# Contact form delivery (src/lib/contactProvider.ts). Currently unset: the
# Contact page honestly reports "delivery isn't connected yet" instead of a
# fake success.
CONTACT_FORM_ENDPOINT=

# Booking / calendar (src/lib/bookingProvider.ts). Currently unset: the
# Book Strategy Call page honestly reports "booking isn't connected yet"
# instead of confirming a call that was never scheduled.
CALENDAR_PROVIDER_API_KEY=
CALENDAR_ID=

# Email notifications on contact/booking submission.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# CRM push for qualified contact/booking records.
CRM_API_KEY=
CRM_WORKSPACE_ID=

# Analytics — must only load client-side once gated behind the visitor's
# Cookie Preferences "Analytics" consent (see src/lib/consent.ts).
ANALYTICS_PROVIDER_ID=

# Error monitoring for production exceptions and failed submissions.
ERROR_MONITORING_DSN=

# Spam protection on the Contact and Book Strategy Call forms (if adopted).
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Third-party consent-management platform, if one replaces the current
# localStorage-backed consent store (src/lib/consent.ts) before launch.
CMP_PROVIDER_KEY=
