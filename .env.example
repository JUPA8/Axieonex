# AXIEONEX production environment variables.
# No values are provided here. Copy to .env.local and fill in real values only
# once a provider has been approved; never commit real secrets. PostgreSQL and
# Auth.js are core runtime dependencies. Turnstile and Upstash fail closed in
# production. Optional provider behavior is documented in docs/INTEGRATIONS.md.

# Public site URL, used for canonical/OG URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=

# --- Backend Phase 1 (foundation: DB, forms, admin auth) ---

# Postgres connection string (Neon/Vercel Postgres). Required for the
# Contact and Book Strategy Call forms to persist anything: without it,
# both server actions catch the Prisma connection error and report an
# honest "not connected" state instead of crashing or faking success.
DATABASE_URL=

# Session-signing secret for Auth.js (src/auth.ts). Required for /admin to
# work at all. Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Email notifications on contact/booking submission, via Resend
# (src/lib/email.ts). Unset: submissions still persist to the database,
# only the internal notification email is skipped.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Cloudflare Turnstile spam protection on the Contact and Book Strategy Call
# forms (src/components/security/TurnstileWidget.tsx,
# src/lib/security/turnstile.ts). CAPTCHA_SITE_KEY is public (safe to expose
# to the browser) and CAPTCHA_SECRET is server-only. Configure both together.
# Production fails closed if absent or partial; local development/tests fail
# open only when both are empty.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Upstash Redis, used for sliding-window rate limiting on the public forms
# and the admin login route (src/lib/security/rateLimit.ts). Configure both
# together. Production fails closed if absent, partial, timed out, or down;
# local development/tests fail open only when both are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Exact single-value request header that the approved deployment proxy
# overwrites with the connecting client IP. Unset means "unknown"; raw
# forwarding headers are never trusted automatically.
TRUSTED_PROXY_IP_HEADER=

# --- Backend Phase 2 (real calendar, CRM, article CMS) ---

# Calendly inline embed (Book Strategy Call, final step;
# src/components/booking/CalendlyEmbed.tsx). A scheduling link, not a
# secret, so it's fine in the client bundle (NEXT_PUBLIC_ prefix required
# for that). Unset: that step shows an honest "not connected yet" notice
# instead of a broken embed, and no booking can be completed.
NEXT_PUBLIC_CALENDLY_URL=

# Server-only verification for Calendly's invitee.created webhook. Configure
# both values together: the signing key used when creating the subscription,
# and the exact Calendly user URI expected in signed payloads. If either is
# unset, the live scheduler remains unavailable and no client event can mark
# a booking confirmed.
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_WEBHOOK_USER_URI=

# HubSpot CRM push (src/lib/crm.ts), Contacts API v3. CRM_API_KEY is a
# HubSpot Private App access token needing both the
# crm.objects.contacts.write and crm.schemas.contacts.write scopes (the
# latter only to create the axieonex_source/axieonex_message custom
# contact properties once; see src/lib/crm.ts for detail). CRM_WORKSPACE_ID
# is optional (HubSpot doesn't require it; it's attached as an
# informational custom property if set). Unset: contact and booking
# submissions still persist and email/notify as usual, just without a CRM
# push (crmSyncedAt stays null).
CRM_API_KEY=
CRM_WORKSPACE_ID=

# --- Backend Phase 3 (compliance, observability, production readiness) ---

# Analytics: must only load client-side once gated behind the visitor's
# Cookie Preferences "Analytics" consent (see src/lib/consent.ts).
ANALYTICS_PROVIDER_ID=

# Error monitoring for production exceptions and failed submissions.
ERROR_MONITORING_DSN=
