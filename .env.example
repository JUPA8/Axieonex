# This build has no backend integration yet — the demo-request form validates
# input locally and does not send data anywhere (see docs/BACKEND_REQUIREMENTS.md).
# Nothing below is used by the app today. It documents what a real
# integration would need, once approved, so the shape is agreed on ahead of
# time. Copy this file to .env.local and fill in real values only when that
# work begins — never commit real secrets.

# Where the demo-request form would deliver submissions once a backend
# exists (e.g. a serverless function, a CRM webhook, or an email API).
# DEMO_FORM_DELIVERY_ENDPOINT=

# Example: if delivery goes through a transactional email provider.
# EMAIL_PROVIDER_API_KEY=

# Example: if leads should also be pushed into a CRM.
# CRM_WEBHOOK_URL=
# CRM_API_KEY=
